{
  "rules": {
    ".read": false,
    ".write": false,
    "publicChat": {
      "messages": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('senderUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['senderUid', 'senderName', 'text', 'createdAt']) && newData.child('senderUid').isString() && newData.child('senderName').isString() && newData.child('senderName').val().length > 0 && newData.child('senderName').val().length <= 60 && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('createdAt').isNumber()",
          "senderUid": { ".validate": "newData.val() === auth.uid" },
          "senderName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "announcement": {
      "current": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_ADMIN_UID'",
        ".validate": "newData.hasChildren(['active', 'text', 'updatedAt']) && newData.child('active').isBoolean() && newData.child('text').isString() && newData.child('text').val().length <= 1000 && newData.child('updatedAt').isNumber()",
        "active": { ".validate": "newData.isBoolean()" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
